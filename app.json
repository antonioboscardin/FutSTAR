{
  "expo": {
    "name": "FutStar",
    "slug": "FutSTAR",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "futstar",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060b14",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.antonioboscardin.futstar",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.antonioboscardin.futstar",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9242849123042157~5228127479",
          "iosAppId": "ca-app-pub-9242849123042157~5228127479"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1137790d-3fe0-4e7e-97b5-f56404c2c7a5"
      }
    },
    "owner": "antonio_boscardin99"
  }
}
